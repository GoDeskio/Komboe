# syntax=docker/dockerfile:1.7
# Build from the repository root:
#   docker build -f docker/Dockerfile.server -t komboe-server .
FROM rust:1.99.0-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/server/upstream
COPY server/upstream/ ./
ENV CARGO_BUILD_JOBS=2
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/server/upstream/target \
    cargo build --release --locked --features sqlite \
    && install -D -m 0755 target/release/vaultwarden /out/komboe

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 komboe \
    && useradd --system --uid 10001 --gid komboe --home-dir /data --no-create-home komboe \
    && install -d -o komboe -g komboe -m 0700 /data \
    && install -d -o komboe -g komboe -m 0755 /web-vault
COPY --from=build /out/komboe /usr/local/bin/komboe
USER 10001:10001
ENV ROCKET_PROFILE=release \
    ROCKET_ADDRESS=0.0.0.0 \
    ROCKET_PORT=8080 \
    DATA_FOLDER=/data \
    WEB_VAULT_FOLDER=/web-vault
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["curl", "--fail", "--silent", "--show-error", "http://127.0.0.1:8080/alive"]
ENTRYPOINT ["/usr/local/bin/komboe"]
